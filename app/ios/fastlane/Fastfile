default_platform(:ios)

platform :ios do
  def api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_KEY_P8"),
      in_house: false
    )
  end

  desc "Signiert mit match, baut das IPA und lädt es zu TestFlight hoch"
  lane :beta do
    setup_ci
    key = api_key
    # Creates certificates/profiles on the first run, afterwards only reads them.
    match(type: "appstore", api_key: key, readonly: ENV["MATCH_READONLY"] == "true")
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore ch.techstein.toni"
    )
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      skip_build_archive: false
    )
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  desc "Reicht den neuesten TestFlight-Build zur App-Store-Prüfung ein"
  lane :release do
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
